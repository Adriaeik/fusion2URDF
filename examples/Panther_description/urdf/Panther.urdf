<?xml version="1.0"?>
<robot name="Panther">

  <link name="base_link">
    <inertial>
      <origin xyz="0.052686 -0.030612 0.049417" rpy="0 0 0"/>
      <mass value="136.252062"/>
      <inertia ixx="2.214653e+00" ixy="1.452886e-01" ixz="7.545022e-02"
               iyy="3.132061e+00" iyz="-2.898040e-02" izz="4.644726e+00"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://Panther_description/meshes/panther/base_link.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
