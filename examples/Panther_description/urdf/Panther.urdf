  </link>

  <link name="mount_link"/>

  <link name="lights_channel_1_link"/>

  <link name="lights_channel_2_link"/>

  <joint name="fr_wheel_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fr_wheel_base_link"/>
    <origin xyz="0.220000 -0.258000 0.000000" rpy="-0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="fl_wheel_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fl_wheel_base_link"/>
    <origin xyz="0.220000 0.258000 0.000000" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="rr_wheel_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rr_wheel_base_link"/>
    <origin xyz="-0.220000 -0.258000 0.000000" rpy="0.000000 -0.000000 -0.000000"/>
  </joint>

  <joint name="rl_wheel_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rl_wheel_base_link"/>
    <origin xyz="-0.220000 0.258000 -0.000000" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="body_to_cover_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cover_link"/>
    <origin xyz="0.000000 -0.000000 0.140000" rpy="0.000000 0.000000 -0.000000"/>
  </joint>

  <joint name="body_to_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.169000 0.025000 0.092000" rpy="0.000000 -0.000000 -1.570796"/>
  </joint>

  <joint name="body_to_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="-0.000000 0.000000 -0.182500" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="body_to_front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.362000 0.000000 0.000000" rpy="0.000000 -0.000000 -0.000000"/>
  </joint>

  <joint name="body_to_rear_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_bumper_link"/>
    <origin xyz="-0.362000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="fr_wheel_joint" type="continuous">
    <parent link="fr_wheel_base_link"/>
    <child link="fr_wheel_link"/>
    <origin xyz="0.000000 -0.091000 0.000000" rpy="-0.000000 -0.000000 0.000000"/>
    <axis xyz="-0.000000 -1.000000 -0.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="fl_wheel_joint" type="continuous">
    <parent link="fl_wheel_base_link"/>
    <child link="fl_wheel_link"/>
    <origin xyz="0.000000 0.091000 0.000000" rpy="0.000000 -0.000000 0.000000"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="rr_wheel_joint" type="continuous">
    <parent link="rr_wheel_base_link"/>
    <child link="rr_wheel_link"/>
    <origin xyz="0.000000 -0.091000 -0.000000" rpy="0.000000 0.000000 -0.000000"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="rl_wheel_joint" type="continuous">
    <parent link="rl_wheel_base_link"/>
    <child link="rl_wheel_link"/>
    <origin xyz="0.000000 0.091000 0.000000" rpy="0.000000 -0.000000 0.000000"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="cover_to_mount_joint" type="fixed">
    <parent link="cover_link"/>
    <child link="mount_link"/>
    <origin xyz="-0.000000 -0.000000 0.031500" rpy="-0.000000 0.000000 -0.000000"/>
  </joint>

  <joint name="front_bumper_to_lights_channel_1_joint" type="fixed">
    <parent link="front_bumper_link"/>
    <child link="lights_channel_1_link"/>
    <origin xyz="-0.000000 0.000000 0.018500" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <joint name="rear_bumper_to_lights_channel_2_joint" type="fixed">
    <parent link="rear_bumper_link"/>
    <child link="lights_channel_2_link"/>
    <origin xyz="0.000000 0.000000 0.018500" rpy="0.000000 -0.000000 0.000000"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Panther_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/Panther_system/cmd</param>
      <param name="state_topic">sim/Panther_system/state</param>
    </hardware>

    <joint name="fl_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="fr_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rl_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rr_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>