<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Assem1_macro">

  <xacro:macro name="Assem1" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.000000 0.080883 0.000000" rpy="0 0 0"/>
        <mass value="458.518628"/>
        <inertia ixx="1.383314e+01" ixy="3.228896e-17" ixz="2.339482e-14"
                 iyy="2.563791e+01" iyz="1.478321e-15" izz="1.383314e+01"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Base0">
      <inertial>
        <origin xyz="0.049736 0.190786 -0.001303" rpy="0 0 0"/>
        <mass value="239.695814"/>
        <inertia ixx="9.415739e+00" ixy="-3.081859e+00" ixz="4.692144e-02"
                 iyy="5.456557e+00" iyz="9.346255e-02" izz="1.153565e+01"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Base0.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Base0_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Arm01">
      <inertial>
        <origin xyz="0.053529 0.366854 -0.000002" rpy="0 0 0"/>
        <mass value="68.994369"/>
        <inertia ixx="1.074135e+01" ixy="-1.111681e-01" ixz="-1.230563e-06"
                 iyy="4.476331e-01" iyz="3.364830e-05" izz="1.039438e+01"/>
      </inertial>
      <visual>
        <origin xyz="-0.020000 1.000000 -0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Arm01.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.020000 1.000000 -0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Arm01_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Arm02">
      <inertial>
        <origin xyz="-0.002051 0.071594 0.110143" rpy="0 0 0"/>
        <mass value="122.591597"/>
        <inertia ixx="9.697336e-01" ixy="7.134262e-03" ixz="2.475546e-03"
                 iyy="1.599893e+00" iyz="-1.000127e-01" izz="1.865600e+00"/>
      </inertial>
      <visual>
        <origin xyz="-0.177000 0.100000 0.120000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Arm02.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.177000 0.100000 0.120000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Arm02_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}for_arm_group">
      <inertial>
        <origin xyz="0.465627 -0.000033 -0.000000" rpy="0 0 0"/>
        <mass value="76.866253"/>
        <inertia ixx="2.134041e-01" ixy="9.151683e-04" ixz="-1.210196e-05"
                 iyy="7.730913e+00" iyz="-1.254132e-06" izz="7.717249e+00"/>
      </inertial>
      <visual>
        <origin xyz="-0.367000 -0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/for_arm_group.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.367000 -0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/for_arm_group_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Part02">
      <inertial>
        <origin xyz="-0.055298 0.000000 -0.000000" rpy="0 0 0"/>
        <mass value="8.277042"/>
        <inertia ixx="1.609093e-02" ixy="-6.388571e-13" ixz="-2.432409e-12"
                 iyy="3.044161e-02" iyz="-6.667105e-23" izz="3.383062e-02"/>
      </inertial>
      <visual>
        <origin xyz="-0.117721 -0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Part02.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.117721 -0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Assem1_description/meshes/Assem1/Part02_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Revolute_1" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Base0"/>
      <origin xyz="0.000000 0.170000 0.000000" rpy="-0.000000 -1.134464 -0.000000"/>
      <axis xyz="-0.000000 1.000000 -0.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_2" type="continuous">
      <parent link="${prefix}Base0"/>
      <child link="${prefix}Arm01"/>
      <origin xyz="0.200000 0.490000 0.030000" rpy="1.047198 -1.570796 0.000000"/>
      <axis xyz="1.000000 0.000000 0.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute3" type="continuous">
      <parent link="${prefix}Arm01"/>
      <child link="${prefix}Arm02"/>
      <origin xyz="0.100000 1.000000 -0.000000" rpy="-1.570796 -0.000000 -1.570796"/>
      <axis xyz="-0.000000 -0.000000 1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute4" type="continuous">
      <parent link="${prefix}Arm02"/>
      <child link="${prefix}for_arm_group"/>
      <origin xyz="0.189000 0.100000 0.120000" rpy="-0.000000 0.000000 -0.000000"/>
      <axis xyz="-1.000000 0.000000 0.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute6" type="revolute">
      <parent link="${prefix}for_arm_group"/>
      <child link="${prefix}Part02"/>
      <origin xyz="0.899000 -0.000000 -0.000000" rpy="-3.141593 -0.000000 3.141593"/>
      <axis xyz="-0.000000 0.000000 1.000000"/>
      <limit lower="-1.745329" upper="1.745329" effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}Assem1_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Assem1_system/cmd</param>
        <param name="state_topic">sim/Assem1_system/state</param>
      </hardware>

      <joint name="${prefix}Revolute3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>